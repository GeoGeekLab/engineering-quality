{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeoGeekLab/engineering-quality/blob/main/evals/schema.json",
  "title": "engineering-quality executable behavioral evaluations",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "task",
      "must_do",
      "must_not_do",
      "fixture",
      "checks"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "task": {
        "type": "string",
        "minLength": 1
      },
      "must_do": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "must_not_do": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "fixture": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files"
        ],
        "properties": {
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "checks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "changed_files_include",
                "changed_files_subset",
                "command",
                "command_no_changes",
                "file_absent",
                "file_contains",
                "file_exists",
                "file_not_contains",
                "file_unchanged",
                "final_contains_all",
                "final_contains_any",
                "final_not_claim_any",
                "final_not_contains_any"
              ]
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "path": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "terms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "repeat": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "exit_code": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
